<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SauceLabs Mobile Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.appium.listeners.TestListener"/>
        <listener class-name="com.appium.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Android Tests - My Demo App">
        <parameter name="platform" value="android"/>
        <parameter name="udid" value="emulator-5554"/>
        <parameter name="systemPort" value="8200"/>
        <classes>
            <class name="com.appium.projects.saucedemo.testcases.LoginTest"/>
        </classes>
    </test>

</suite>
