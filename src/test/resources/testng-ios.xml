<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SauceLabs Mobile Automation Suite - iOS Simulator" verbose="1">

    <listeners>
        <listener class-name="com.appium.listeners.TestListener"/>
        <listener class-name="com.appium.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="iOS Tests - My Demo App">
        <parameter name="platform" value="ios_simulator"/>
        <parameter name="udid" value=""/>
        <parameter name="systemPort" value="8100"/>
        <classes>
            <class name="com.appium.projects.saucedemo.testcases.LoginTest"/>
        </classes>
    </test>

</suite>
